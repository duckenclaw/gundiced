; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Gundiced"
config/description="Turn-based grid duel: two robot gunslingers, a D6 for action points, crates, swinging doors and a handful of guns."
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/players/player1.png"

[autoload]

EventBus="*res://addons/core/event_bus.gd"
GameSettings="*res://src/globals/game_settings.gd"
SceneManager="*res://addons/core/scene_manager.gd"
AudioManager="*res://addons/core/audio_manager.gd"
SaveManager="*res://addons/core/save_manager.gd"
Localization="*res://addons/core/localization.gd"
Debug="*res://addons/core/debug_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/core/plugin.cfg", "res://addons/settings_kit/plugin.cfg", "res://addons/components_kit/plugin.cfg")

